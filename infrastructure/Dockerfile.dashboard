FROM ghcr.io/astral-sh/uv:0.11.18 AS uv
FROM python:3.12.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/workspace/.venv/bin:$PATH
COPY --from=uv /uv /uvx /bin/
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY apps/dashboard ./apps/dashboard
RUN adduser --system --group dashboard && chown -R dashboard:dashboard /workspace
USER dashboard
CMD ["streamlit", "run", "apps/dashboard/app.py"]
