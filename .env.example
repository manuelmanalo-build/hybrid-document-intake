POSTGRES_DB=document_intake
POSTGRES_USER=document_intake
POSTGRES_PASSWORD=change-me-local-postgres
INTAKE_ENVIRONMENT=local
INTAKE_DATABASE_URL=postgresql+psycopg://document_intake:change-me-local-postgres@postgres:5432/document_intake
INTAKE_STORAGE_ROOT=/var/lib/document-intake/objects
INTAKE_UPLOAD_MAX_BYTES=10485760
INTAKE_UPLOAD_CHUNK_BYTES=65536
INTAKE_BOOTSTRAP_TENANT_ID=00000000-0000-4000-8000-000000000001
INTAKE_BOOTSTRAP_USER_ID=00000000-0000-4000-8000-000000000002
INTAKE_BOOTSTRAP_TENANT_NAME=Local Demo Tenant
INTAKE_BOOTSTRAP_USER_SUBJECT=local-demo-submitter
INTAKE_DEMO_SUBMITTER_TOKEN=replace-with-a-long-random-local-demo-token
INTAKE_DEMO_REVIEWER_TOKEN=replace-with-a-different-long-random-local-reviewer-token
INTAKE_DEMO_APPROVER_TOKEN=replace-with-a-different-long-random-local-approver-token
INTAKE_DEMO_OPERATIONS_ADMIN_TOKEN=replace-with-a-different-long-random-local-admin-token
INTAKE_DEMO_AUDITOR_TOKEN=replace-with-a-different-long-random-local-auditor-token
INTAKE_DEMO_ROLE_LOGIN_ENABLED=true
INTAKE_DEMO_SESSION_TTL_SECONDS=28800
INTAKE_DEMO_SESSION_MAX_ACTIVE=100
INTAKE_GRAPH_VERSION=document-intake-v1
INTAKE_CHECKPOINT_DATABASE_URL=postgresql://document_intake:change-me-local-postgres@postgres:5432/document_intake
INTAKE_GRAPH_REQUEST_MAX_ATTEMPTS=5
INTAKE_GRAPH_REQUEST_LEASE_SECONDS=30
INTAKE_GRAPH_REQUEST_POLL_SECONDS=2
INTAKE_GRAPH_REQUEST_BACKOFF_BASE_SECONDS=2
INTAKE_GRAPH_REQUEST_BACKOFF_MAX_SECONDS=60
LANGGRAPH_STRICT_MSGPACK=true
AGENT_PROVIDER=stub
AGENT_MODEL=configure-model-name
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=document-intake-local
EVALUATION_LANGSMITH_ENABLED=false
EVALUATION_LANGSMITH_DATASET=document-intake-local-evaluation
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_EXTRACTION_ATTEMPTS=3
AGENT_TOTAL_TIMEOUT_SECONDS=120
AGENT_TOOL_TIMEOUT_SECONDS=30
INTAKE_ZAPIER_HOOK_URL=
INTAKE_ZAPIER_AUTH_TOKEN=
INTAKE_ZAPIER_SIGNING_SECRET=
INTAKE_ZAPIER_CALLBACK_TOKEN=
INTAKE_WEBHOOK_TIMEOUT_SECONDS=10
INTAKE_WEBHOOK_MAX_ATTEMPTS=5
INTAKE_WEBHOOK_LEASE_SECONDS=30
INTAKE_WEBHOOK_POLL_SECONDS=2
INTAKE_WEBHOOK_BACKOFF_BASE_SECONDS=2
INTAKE_WEBHOOK_BACKOFF_MAX_SECONDS=300
MOCK_ZAPIER_FAILURES_BEFORE_SUCCESS=0
MOCK_ZAPIER_RESPONSE_STATUS=202
